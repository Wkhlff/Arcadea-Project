<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo_arcadea_tanpa_bg"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo_arcadea_tanpa_bg"
        android:supportsRtl="true"
        android:theme="@style/Theme.Arcadeaproject"
        android:usesCleartextTraffic="true"
        tools:targetApi="m">

        <activity
            android:name=".ui.main.Initial.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.main.Initial.SignInActivity" android:exported="false" />
        <activity android:name=".ui.main.Initial.RegisterActivity" android:exported="false" />
        <activity android:name=".ui.main.DetailActivity" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="false" />
        <activity android:name=".ui.main.profile.ProfileEditActivity" android:exported="false" />
        <activity android:name=".ui.main.cart.CheckoutSuccessActivity" android:exported="false" />

    </application>

</manifest>